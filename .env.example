# AI assist (optional). Without all three the /api/assist route returns 503 and the demo runs unchanged.
# Server-only. Never prefix with NEXT_PUBLIC_. Set the same three in the Vercel project for the hosted demo.
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=
AI_ASSIST_PASSCODE=

# Email sending (optional). Without all three, /api/send returns 503 and drafts stay download-only.
# SMTP_USER is the FIRM / AGENT mailbox that sends requests (a Gmail you control for the demo).
# Gmail: enable 2-Step Verification on that account, then Google Account → Security → App passwords.
SMTP_USER=peregrine.adviser.demo@gmail.com
SMTP_PASS=
# The FAMILY (external client) inbox that receives requests. Only listed addresses can ever be sent to.
OUTREACH_ALLOWED_RECIPIENTS=taylorfamilyexample@gmail.com
